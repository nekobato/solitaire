{
  "name": "@nekobato/solitaire",
  "version": "0.1.0",
  "description": "TUI Solitaire for the terminal",
  "keywords": [
    "solitaire",
    "klondike",
    "freecell",
    "cli",
    "terminal",
    "blessed"
  ],
  "license": "MIT",
  "bin": {
    "solitaire": "dist/solitaire.js"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist/**"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "start": "tsx src/solitaire.ts",
    "test": "tsx --test src/test/**/*.test.ts",
    "format": "prettier -w .",
    "format:check": "prettier -c ."
  },
  "dependencies": {
    "blessed": "^0.1.81"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "prettier": "^3.2.5",
    "tsx": "^4.21.0",
    "typescript": "^5.4.5"
  }
}
