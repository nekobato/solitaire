{
  "name": "@nekobato/solitaire",
  "version": "0.1.2",
  "packageManager": "pnpm@10.33.0",
  "description": "TUI Solitaire for the terminal",
  "homepage": "https://github.com/nekobato/solitaire",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nekobato/solitaire.git"
  },
  "bugs": {
    "url": "https://github.com/nekobato/solitaire/issues"
  },
  "keywords": [
    "solitaire",
    "klondike",
    "freecell",
    "cli",
    "terminal",
    "blessed"
  ],
  "license": "MIT",
  "bin": {
    "solitaire": "dist/solitaire.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist/**",
    "!dist/test/**"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "pnpm run build",
    "start": "tsx src/solitaire.ts",
    "test": "tsx --test src/test/**/*.test.ts",
    "format": "prettier -w .",
    "format:check": "prettier -c ."
  },
  "dependencies": {
    "blessed": "0.1.81"
  },
  "devDependencies": {
    "@types/node": "26.3.0",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  }
}
