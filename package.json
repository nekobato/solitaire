{
  "name": "@nekobato/solitaire",
  "version": "0.1.1",
  "description": "TUI Solitaire for the terminal",
  "homepage": "https://github.com/nekobato/solitaire",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nekobato/solitaire.git"
  },
  "bugs": {
    "url": "https://github.com/nekobato/solitaire/issues"
  },
  "keywords": [
    "solitaire",
    "klondike",
    "freecell",
    "cli",
    "terminal",
    "blessed"
  ],
  "license": "MIT",
  "bin": {
    "solitaire": "dist/solitaire.js"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist/**",
    "!dist/test/**"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "start": "tsx src/solitaire.ts",
    "test": "tsx --test src/test/**/*.test.ts",
    "format": "prettier -w .",
    "format:check": "prettier -c ."
  },
  "dependencies": {
    "blessed": "^0.1.81"
  },
  "devDependencies": {
    "@types/node": "^25.0.10",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
